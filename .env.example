# Healix Platform Environment Configuration
PROJECT_NAME="Healix Explainable AI Health Platform"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security
JWT_SECRET=healix-super-secret-key-change-in-production-2026-nsut-ai
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Async SQLite default, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./healix.db

# Clinical Triage & Safety
ENABLE_EMERGENCY_OVERRIDE=true
DEFAULT_EMERGENCY_PHONE=112
KB_DEFAULT_VERSION=v2.0.0

# Optional Gemini Integration for Assessment Summarization
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

