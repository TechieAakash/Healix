# ===================================================
# Healix Backend Environment Variables
# ===================================================

# Database (Production uses MySQL; can fallback to SQLite for lightweight local dev/testing)
DATABASE_URL=mysql+pymysql://healix_user:healix_password@localhost:3306/healix_db

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production_healix_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Application Settings
ENVIRONMENT=development
PROJECT_NAME=Healix Healthcare Triage Assistant API
API_V1_STR=/api/v1
DEBUG=true

# AI layer: local is deterministic and offline; only set a key for explicit OpenAI use.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1200
AI_BASE_URL=
AI_REQUEST_TIMEOUT=30.0
AI_MAX_RETRIES=2

# RAG & Vector Database Settings
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_URL=
VECTOR_DB_PATH=data/vector_store.json
RAG_TOP_K=4
SIMILARITY_THRESHOLD=0.25
ENABLE_RAG_RERANKING=true

# Prompt Engineering
PROMPT_VERSION=v1
